{
  "id": "ghosti.pelis-tv",
  "name": "Pelis-TV",
  "version": "1.0.1",
  "apiVersion": 14,
  "description": "Plugin para ver series y pelis",
  "icon": "https://tu-icono.png",
  "catalogs": [
    {
      "type": "series",
      "id": "pelis-tv-series",
      "name": "Series Pelis-TV"
    },
    {
      "type": "movie",
      "id": "pelis-tv-movies", 
      "name": "Pelis Pelis-TV"
    }
  ],
  "resources": ["catalog", "meta", "stream"],
  "types": ["series", "movie"],
  "behaviorHints": {
    "configurationRequired": false,
    "adult": false,
    "cacheMeta": true,
    "cacheCatalog": true
  }
}