{
  "id": "pelisjuanita",
  "name": "PelisJuanita",
  "description": "Películas y series, en español.",
  "version": "1.1.3",
  "apiVersion": 20,
  "entry": "plugin.js",
  "icon": "icon.png",
  "hosts": ["pelisjuanita.com", "image.tmdb.org"],
  "fetchHosts": "any",
  "streamHosts": "any",
  "browser": true,
  "capabilities": ["home", "search", "episodes", "resolve", "screen", "download"],
  "screen": {
    "label": "PelisJuanita",
    "labelEn": "PelisJuanita",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": ["menu", "settings"],
    "settingsIn": "screen"
  },
  "openFrom": { "routes": ["detalle"] },
  "consumes": {
    "social": { "repo": "kinotvapp/kino-social", "door": "wall", "calls": ["share"] }
  },
  "recommends": ["kinotvapp/kino-social"]
}