{
  "id": "kimera",
  "name": "Kimera",
  "version": "0.4.1",
  "apiVersion": 14,
  "entry": "plugin.js",
  "icon": "icon.png",
  "author": "ghosti-vc",
  "description": "Películas, series, dramas y animes de Kimera: estrenos, lo más visto y lo último agregado.",
  "color": "#1c1f24",
  "categories": ["movies", "series", "anime"],
  "hosts": ["kimeraweb.com", "cloudcdn.sbs"],
  "streamHosts": "any",
  "capabilities": ["home", "browse", "search", "episodes", "resolve", "byteSource", "screen"],
  "screen": {
    "label": "Kimera",
    "icon": "movie"
  },
  "recommends": ["kinotvapp/kino-social"],
  "enhancements": {
    "20": {
      "consumes": {
        "social": {
          "repo": "kinotvapp/kino-social",
          "calls": ["share"],
          "door": "wall"
        }
      },
      "openFrom": { "routes": ["detail"] }
    }
  }
}