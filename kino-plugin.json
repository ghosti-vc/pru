{
  "id": "pelis-tv",
  "name": "Pelis TV",
  "description": "Películas, series, anime, series turcas y caricaturas en español desde muchas fuentes.",
  "author": "Ghosti-vc",
  "version": "0.9.0",
  "apiVersion": 9,
  "entry": "plugin.js",
  "capabilities": [
    "home",
    "browse",
    "search",
    "episodes",
    "resolve"
  ],
  "hosts": [
    "pelisjuanita.org",
    "www.pelisjuanita.org",
    "hackstore3.net",
    "www.fuegocine.com",
    "pelisflix200.store",
    "image.tmdb.org",
    "www.poseidonhd2.co",
    "player.poseidonhd2.co",
    "wv3.cuevana3.eu",
    "www.pelisplushd.la",
    "tioplus.app",
    "www.cinecalidad.am",
    "www3.seriesmetro.net",
    "www.lacartoons.com",
    "tbg.seriesturcastv.to",
    "seriesflixhd.lol",
    "pelisflixhd.win",
    "api.themoviedb.org"
  ],
  "browser": true,
  "fetchHosts": "any",
  "streamHosts": "any",
  "settings": [
    {
      "key": "epsource",
      "label": "Lista de capítulos",
      "labelEn": "Episode list",
      "type": "select",
      "default": "fuentes",
      "options": [
        {
          "value": "fuentes",
          "label": "De las fuentes (por defecto)",
          "labelEn": "From the sources (default)"
        },
        {
          "value": "tmdb",
          "label": "De TMDB (rápida, prueba)",
          "labelEn": "From TMDB (fast, test)"
        }
      ]
    },
    {
      "key": "tmdbKey",
      "label": "Clave de TMDB (solo si usas TMDB)",
      "labelEn": "TMDB key (only for TMDB)",
      "type": "text",
      "default": ""
    }
  ]
}
