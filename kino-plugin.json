{
  "id": "kimera",
  "name": "Kimera",
  "version": "0.2.1",
  "apiVersion": 6,
  "entry": "plugin.js",
  "icon": "icon.png",
  "author": "ghosti-vc",
  "description": "Películas, series, dramas y animes de Kimera: estrenos, lo más visto y lo último agregado, con audio latino e inglés.",
  "color": "#1c1f24",
  "categories": ["movies", "series", "anime"],
  "hosts": ["kimeraweb.com", "cloudcdn.sbs"],
  "streamHosts": "any",
  "capabilities": ["home", "browse", "search", "episodes", "resolve", "download"],
  "recommends": ["kinotvapp/kino-social"],
  "settings": [
    {
      "key": "mix",
      "type": "toggle",
      "label": "Unir el audio al video",
      "default": true,
      "hint": "Cose el video con el audio latino. Apágalo si algún título falla."
    }
  ],
  "enhancements": {
    "14": {
      "screen": {
        "label": "Kimera",
        "icon": "movie"
      }
    },
    "20": {
      "consumes": {
        "social": {
          "repo": "kinotvapp/kino-social",
          "door": "wall",
          "calls": ["share"]
        }
      },
      "openFrom": { "routes": ["detail"] }
    }
  }
}