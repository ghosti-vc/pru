{
  "id": "pelisjuanita",
  "name": "PelisJuanita",
  "description": "Películas y series, en español.",
  "version": "1.0.0",
  "apiVersion": 20,
  "entry": "plugin.js",
  "icon": "icon.png",
  "hosts": ["pelisjuanita.com", "image.tmdb.org"],
  "fetchHosts": "any",
  "streamHosts": "any",
  "browser": true,
  "capabilities": ["home", "search", "resolve", "screen", "download"],
  "consumes": {
    "social": { "repo": "kinotvapp/kino-social", "door": "wall", "calls": ["share"] }
  },
  "recommends": ["kinotvapp/kino-social"]
} 